generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          String    @default("USER") // USER, ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id])

  // NextAuth fields
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  leads     Lead[]
  customers Customer[]
  jobs      Job[]

  @@map("workspaces")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  source      String?  // website, referral, social, etc.
  status      String   @default("NEW") // NEW, CONTACTED, QUALIFIED, LOST, WON
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  totalSpent  Float    @default(0)
  totalOrders Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs        Job[]

  @@map("customers")
}

model Job {
  id            String   @id @default(cuid())
  title         String
  description   String?
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, PAID, DELIVERED, CANCELLED

  // Vehicle info
  vehicleMake   String?
  vehicleModel  String?
  vehicleYear   Int?
  vehiclePlate  String?

  // Pricing
  labourCost    Float    @default(0)
  partsCost     Float    @default(0)
  totalCost     Float    @default(0)

  // Dates
  dateReceived  DateTime @default(now())
  dateDue       DateTime?
  dateCompleted DateTime?
  dateDelivered DateTime?

  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("jobs")
}